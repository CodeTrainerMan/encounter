# ============================================================
# Encounter 环境变量
# ============================================================
# 本地开发：复制本文件为 .env.local 后填写。
# 线上（Vercel）：在 Project → Settings → Environment Variables 里逐条添加，
# 改动后需要重新部署。`.env.local` 不入库，也不要提交。
# ============================================================

# 数据库连接串。
#
# 本地开发（推荐）：先执行 `docker compose up -d` 启动一个 PostgreSQL，
# 然后用下面这行（注意用 127.0.0.1：Windows 下 localhost 可能解析到 IPv6 ::1，
# 而 Docker 的端口映射只监听 IPv4，会 ETIMEDOUT）：
#   DATABASE_URL=postgresql://encounter:encounter@127.0.0.1:5433/encounter
# 本地库走 node-postgres 标准 TCP 连接（见 src/lib/db.ts）。
#
# 线上（Vercel / Neon）：在 Vercel 控制台 Storage → Create Database → Postgres
# 创建后会自动注入本变量（同时还会注入 POSTGRES_URL / PGHOST 等一整套，
# 但代码只读 DATABASE_URL，其余可以不管）。
#
# 用 Neon 时请选 **pooled** 连接串（主机名带 `-pooler`）：
#   postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?channel_binding=require&sslmode=require
# 连接串里的 channel_binding / sslmode 参数不用删，两种驱动都能正常解析。
#
# 建表：连接串就绪后执行一次 `npm run db:init`；`db/schema.sql` 全部是
# `if not exists`，可以安全重复执行。
#
# 留空也不会报错：站点降级为空状态——页面照常打开，但时间流为空、也不能写入。
DATABASE_URL=

# 站点自身的公开地址。
# 影响 og:url / metadataBase、sitemap.xml、robots.txt 里的绝对链接。
# 线上必须改成正式域名，否则这些位置会指向 localhost；改动后需要重新部署。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# 登录（Discord OAuth）
# ============================================================
# 在 https://discord.com/developers/applications 新建应用 → OAuth2，
# 把 Redirect URI 填成：
#   http://localhost:3000/api/auth/callback/discord
# 上线时**必须**再补一条线上的，否则线上点登录会报 redirect_uri 不合法：
#   https://你的域名/api/auth/callback/discord
#
# 站点只申请 identify 权限，不读取邮箱。
#
# 以下三个变量缺任意一个，站点会自动降级为「只读」：能浏览，
# 但不能写记录、不能贴表情，页面上也不会出现登录按钮。
# 这样本地开发和演示模式不必先去 Discord 建应用。
AUTH_SECRET=            # 用 `npx auth secret` 或 `openssl rand -base64 33` 生成
AUTH_DISCORD_ID=        # Discord 开发者后台 OAuth2 -> Client ID
AUTH_DISCORD_SECRET=    # Discord 开发者后台 OAuth2 -> Client Secret

# 管理员：可以编辑 / 删除任何人的记录。
# 用途有两个：清理别人贴进来的垃圾内容，以及接管接入登录之前
# 就已存在、author_id 为空的历史记录（那些记录按「只有作者能改」
# 的规则谁也动不了）。
#
# 这里要填 **Discord 用户 ID（一串数字）**，不是 @用户名：
# 填用户名不会报错，但永远匹配不上，表现为「配了管理员却不生效」。
# 获取方式：Discord 设置 → 高级 → 打开「开发者模式」，
# 然后右键自己的头像 → 复制用户 ID。
# 多个用逗号分隔（中文逗号、空格也可以）。
ADMIN_DISCORD_IDS=
